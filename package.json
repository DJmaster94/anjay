{
  "name": "satoshi-bitcoin-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && vite build --mode pages",
    "snapshot:pages": "node scripts/generate-pages-data.mjs",
    "preview:pages": "vite preview --mode pages --host 0.0.0.0 --port 4176 --strictPort",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:pages": "npm run build:pages && playwright test --config playwright.pages.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.3.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
